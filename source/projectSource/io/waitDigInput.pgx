<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="waitDigInput" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_dIn" type="dio" xsi:type="element" />
      <Parameter name="x_bValue" type="bool" xsi:type="element" />
      <Parameter name="x_bError" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_sDesc" type="string" xsi:type="array" size="1" />
      <Local name="l_sPath" type="string" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if ioStatus(x_dIn,l_sDesc,l_sPath)>=0
    x_bError=false
    wait(x_dIn==x_bValue)
  else
    x_bError=true
    logMsg("通信终端，等待通信恢复")
    wait(x_dIn==x_bValue)
    logMsg("通信已恢复")
    //    logMsg("Signal "+l_sPath+" error."+"Description:"+l_sDesc)
  endIf
end]]></Code>
  </Program>
</Programs>