<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="updateStr" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nItemIn" type="num" xsi:type="element" />
      <Parameter name="x_sTextOut" type="string" xsi:type="element" use="reference" />
      <Parameter name="x_sComment" type="string" xsi:type="element" />
    </Parameters>
    <Code><![CDATA[begin
  switch sLanguage
    case "chinese"
      x_sTextOut=sHmiCN[x_nItemIn]
    break
    //
    case "english"
      x_sTextOut=sHmiEN[x_nItemIn]
    break
  endSwitch
end]]></Code>
  </Program>
</Programs>