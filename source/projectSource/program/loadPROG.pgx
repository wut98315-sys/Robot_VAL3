<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="loadPROG" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nLib" type="num" xsi:type="element" />
      <Parameter name="x_nResult" type="num" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_sPath" type="string" xsi:type="array" size="1" />
      <Local name="l_nClock" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  l_nClock=clock()
  if x_nLib>=0
    
    l_sPath="Disk://data/CustomerLib/lib"+toString("",x_nLib)+"/savePROG"
    x_nResult=progTemp:libLoad(l_sPath)
    if x_nResult!=0
      popUpMsg("1")
      call rs:setAlarm(300,0)
    endIf
  else
    call rs:setAlarm(302,0)
  endIf
  logMsg(progTemp:libPath()+",耗时:"+toString(".3",clock()-l_nClock))
  
end]]></Code>
  </Program>
</Programs>