<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="setIOStatus" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nType" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_nSize" type="num" xsi:type="array" size="1" />
      <Local name="l_selColor" type="string" xsi:type="array" size="1" />
      <Local name="l_sNullColor" type="string" xsi:type="array" size="1" />
      <Local name="l_sbtn" type="string" xsi:type="array" size="1" />
      <Local name="l_sErrColor" type="string" xsi:type="array" size="1" />
      <Local name="l_slabel" type="string" xsi:type="array" size="1" />
      <Local name="l_nValue" type="num" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_nSize1" type="num" xsi:type="array" size="1" />
      <Local name="l_slbl1" type="string" xsi:type="array" size="1" />
      <Local name="l_slbl2" type="string" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  l_selColor="#33FF33"
  l_sNullColor="#FFFFFF"
  l_sErrColor="#C8C8C8"
  call getSize(l_nSize,l_nSize1)
  //  if l_nSize<16
  //    for l_i = l_nSize to 15
  //      l_sbtn="btn"+toString("",60+l_i)
  //      l_slbl1="lbl"+toString("",20+l_i)
  //      l_slbl2="lbl"+toString("",l_i)
  //      userPageSet("IO",l_sbtn,"style.visibility","hidden")   
  //      userPageSet("IO",l_slbl1,"style.visibility","hidden")   
  //      userPageSet("IO",l_slbl2,"style.visibility","hidden")   
  //    endFor
  //  endIf
  //  if l_nSize1<16
  //    for l_i = l_nSize1 to 15
  //      l_sbtn="lbl"+toString("",40+l_i)
  //      l_slbl1="lbl"+toString("",20+l_i)
  //      l_slbl2="lbl"+toString("",l_i)
  //      userPageSet("IO",l_sbtn,"style.visibility","hidden")   
  //      userPageSet("IO",l_slbl1,"style.visibility","hidden")   
  //      userPageSet("IO",l_slbl2,"style.visibility","hidden")   
  //    endFor
  //  endIf
  
  switch x_nType
    case 0
      for l_i = 0 to l_nSize-1
        l_sbtn="btn"+toString("",60+l_i)
        //     userPageSet("IO",l_sbtn,"style.visibility","visible")
        if ioStatus(io:dInItem[l_i+nPageIndex*16].dDio)>-1
          l_nValue=dioGet(io:dInItem[l_i+nPageIndex*16].dDio)
          if l_nValue==1
            userPageSet("IO",l_sbtn,"style.backgroundColor",l_selColor)
          else
            userPageSet("IO",l_sbtn,"style.backgroundColor",l_sNullColor)
          endIf
        else
          userPageSet("IO",l_sbtn,"style.backgroundColor",l_sErrColor)
        endIf
      endFor
    break
    case 1
      for l_i = 0 to l_nSize-1
        l_sbtn="btn"+toString("",60+l_i)
        //     userPageSet("IO",l_sbtn,"style.visibility","visible")
        if ioStatus(io:dOutItem[l_i+nPageIndex*16].dDio)>-1
          l_nValue=dioGet(io:dOutItem[l_i+nPageIndex*16].dDio)
          if l_nValue==1
            userPageSet("IO",l_sbtn,"style.backgroundColor",l_selColor)
          else
            userPageSet("IO",l_sbtn,"style.backgroundColor",l_sNullColor)
          endIf
        else
          userPageSet("IO",l_sbtn,"style.backgroundColor",l_sErrColor)
        endIf
      endFor
    break
    case 2
      for l_i = 0 to l_nSize1-1
        l_slabel="lbl"+toString("",40+l_i)
        //       userPageSet("IO",l_slabel,"style.visibility","visible")
        if ioStatus(io:aInItem[l_i+nPageIndex*16].aAio)>-1
          l_nValue=aioGet(io:aInItem[l_i+nPageIndex*16].aAio)
          sValue[l_i]=toString(".2",l_nValue)
        else
          sValue[l_i]="?"
        endIf
      endFor
    break
    case 3
      for l_i = 0 to l_nSize1-1
        l_slabel="lbl"+toString("",40+l_i)
        //      userPageSet("IO",l_slabel,"style.visibility","visible")
        if ioStatus(io:aOutItem[l_i+nPageIndex*16].aAio)>-1
          l_nValue=aioGet(io:aOutItem[l_i+nPageIndex*16].aAio)
          sValue[l_i]=toString(".2",l_nValue)
        else
          sValue[l_i]="?"
        endIf
      endFor
    break
      
  endSwitch
 
end]]></Code>
  </Program>
</Programs>