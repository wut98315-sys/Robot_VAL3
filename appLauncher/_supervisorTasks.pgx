<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_supervisorTasks" access="public">
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  for l_i = 0 to size(_nClock)-1
    _nClock[l_i]=0
  endFor
  do
    //任务监控
    //注意：计时器只能在任务正常时刷新，否则"异常持续5s"的条件永远不会成立
    if taskStatus("plc")>1
      if clock()-_nClock[1]>5
        _nClock[1]=clock()
        taskResume("plc",0)
        rs:bIsError=true
      endIf
    else
      _nClock[1]=clock()
    endIf
    if taskStatus("appMain")>1
      if clock()-_nClock[2]>5
        _nClock[2]=clock()
        rs:bIsError=true
        taskResume("appMain",0)
      endIf
    else
      _nClock[2]=clock()
    endIf
    if taskStatus("HMI")>1
      //保存当前数据
      bTosave=true
      call trajectory:onSave(bTosave)
      bTosave=true
      call program:onSave(bTosave)
      wait(rs:bIsSaving==false)
      l_bResult=userPageConfirm("需要重载HMI应用？")
      if l_bResult

        taskKill("HMI")
        wait(taskStatus("HMI")==-1)
        taskCreate "HMI",50,home:main()
        wait(taskStatus("HMI")==1)
      endIf
    endIf
   

    delay(0)
  until false
end]]></Code>
  </Program>
</Programs>
