<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="simulateHome" access="public">
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_bExit" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if !rs:bIsCycle and workingMode()==1
    l_bResult=userPageConfirm("是否移动到Home位置？")
    if l_bResult
      rs:bSimulate=true

      taskCreate "simulate",50,goHome()
      sMsg="回Home过程。。。"
      call simulate_UI()
    endIf
  else
    userPageAlert("条件不满足：不再生产周期&切换到手动模式")
  endIf
end]]></Code>
  </Program>
</Programs>