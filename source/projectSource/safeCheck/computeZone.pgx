<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="computeZone" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nIndex" type="num" xsi:type="element" />
      <Parameter name="x_bResult" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_tTool" type="tool" xsi:type="array" size="1" />
      <Local name="l_fFrame" type="frame" xsi:type="array" size="1" />
      <Local name="l_trFirst" type="trsf" xsi:type="array" size="1" />
      <Local name="l_trSecond" type="trsf" xsi:type="array" size="1" />
      <Local name="l_nMax_x" type="num" xsi:type="array" size="1" />
      <Local name="l_nMax_y" type="num" xsi:type="array" size="1" />
      <Local name="l_nMax_z" type="num" xsi:type="array" size="1" />
      <Local name="l_nMin_x" type="num" xsi:type="array" size="1" />
      <Local name="l_nMin_y" type="num" xsi:type="array" size="1" />
      <Local name="l_nMin_z" type="num" xsi:type="array" size="1" />
      <Local name="l_pPoint" type="pointRx" xsi:type="array" size="1" />
      <Local name="l_bReuslt1" type="bool" xsi:type="array" size="1" />
      <Local name="l_bReuslt2" type="bool" xsi:type="array" size="1" />
      <Local name="l_bReuslt3" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  link(l_tTool,flange)
  link(l_fFrame,world)
  l_fFrame.trsf=safeTemp:zZoneItem[x_nIndex].fBase.trsf
  call savedata:getTool(nToolIndex,l_tTool)
  l_pPoint=here(l_tTool,l_fFrame)
  l_trFirst=safeTemp:zZoneItem[x_nIndex].pFirst.trsf
  l_trSecond=safeTemp:zZoneItem[x_nIndex].pSecond.trsf
  
  l_nMax_x=max(l_trFirst.x,l_trSecond.x)
  l_nMax_y=max(l_trFirst.y,l_trSecond.y)
  l_nMax_z=max(l_trFirst.z,l_trSecond.z)
  l_nMin_x=min(l_trFirst.x,l_trSecond.x)
  l_nMin_y=min(l_trFirst.y,l_trSecond.y)
  l_nMin_z=min(l_trFirst.z,l_trSecond.z)
  
  if l_nMin_x<l_pPoint.trsf.x and l_pPoint.trsf.x<l_nMax_x
    l_bReuslt1=true
  else
    l_bReuslt1=false
  endIf
  
  if l_nMin_y<l_pPoint.trsf.y and l_pPoint.trsf.y<l_nMax_y
    l_bReuslt2=true
  else
    l_bReuslt2=false
  endIf
  
  if l_nMin_z<l_pPoint.trsf.z and l_pPoint.trsf.z<l_nMax_z
    l_bReuslt3=true
  else
    l_bReuslt3=false
  endIf
  
  if l_bReuslt1 and l_bReuslt2 and l_bReuslt3
    x_bResult=true
  else
    x_bResult=false
  endIf
end]]></Code>
  </Program>
</Programs>