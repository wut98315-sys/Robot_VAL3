<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="logMoveMsgC">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_pPoint1" type="pointRx" xsi:type="element" />
      <Parameter name="x_pPoint2" type="pointRx" xsi:type="element" />
      <Parameter name="x_tTool" type="tool" xsi:type="element" />
      <Parameter name="x_mSpeed" type="mdesc" xsi:type="element" />
      <Parameter name="x_nMoveId" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_sCode" type="string" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="2" />
      <Local name="l_jRef" type="jointRx" xsi:type="array" size="1" />
      <Local name="l_jResult" type="jointRx" xsi:type="array" size="2" />
    </Locals>
    <Code><![CDATA[begin
  //
  if nRecIndex<200
    // c
    if nRecIndex>=1
      l_jRef=jPointRec[nRecIndex-1,1]
    else
      l_jRef=herej()
    endIf
    l_bResult[0]=pointToJoint(x_tTool,l_jRef,x_pPoint1,l_jResult[0])
    l_bResult[1]=pointToJoint(x_tTool,l_jResult[0],x_pPoint2,l_jResult[1])
    //
    if l_bResult[0]==true and l_bResult[1]==true
      setMutex(bPushToStack)
      jPointRec[nRecIndex,0]=l_jResult[0]
      jPointRec[nRecIndex,1]=l_jResult[1]
      trToolRec[nRecIndex]=x_tTool.trsf
      mSpeedRec[nRecIndex]=x_mSpeed
      nMoveIdRec[nRecIndex]=x_nMoveId
      nMoveTypeRec[nRecIndex]=3
      //logMsg("record moveC."+toString("",nMoveIdRec[nRecIndex]))
      nRecIndex=nRecIndex+1
      bPushToStack=false
    else
      // 无关节解
    endIf
  else
    //popUpMsg("记录点数超过容量.")
  endIf
  
end]]></Code>
  </Program>
</Programs>