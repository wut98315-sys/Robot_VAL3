<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="InverseMatrix" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nMatrixOrigin" type="num" xsi:type="array" use="reference" dimensions="2" />
      <Parameter name="x_nMatrixNew" type="num" xsi:type="array" use="reference" dimensions="2" />
      <Parameter name="x_bStatus" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="A11" type="num" xsi:type="array" size="1" />
      <Local name="A12" type="num" xsi:type="array" size="1" />
      <Local name="A13" type="num" xsi:type="array" size="1" />
      <Local name="A14" type="num" xsi:type="array" size="1" />
      <Local name="A21" type="num" xsi:type="array" size="1" />
      <Local name="A22" type="num" xsi:type="array" size="1" />
      <Local name="A23" type="num" xsi:type="array" size="1" />
      <Local name="A24" type="num" xsi:type="array" size="1" />
      <Local name="A31" type="num" xsi:type="array" size="1" />
      <Local name="A32" type="num" xsi:type="array" size="1" />
      <Local name="A33" type="num" xsi:type="array" size="1" />
      <Local name="A34" type="num" xsi:type="array" size="1" />
      <Local name="A41" type="num" xsi:type="array" size="1" />
      <Local name="A42" type="num" xsi:type="array" size="1" />
      <Local name="A43" type="num" xsi:type="array" size="1" />
      <Local name="A44" type="num" xsi:type="array" size="1" />
      <Local name="a11" type="num" xsi:type="array" size="1" />
      <Local name="a12" type="num" xsi:type="array" size="1" />
      <Local name="a13" type="num" xsi:type="array" size="1" />
      <Local name="a14" type="num" xsi:type="array" size="1" />
      <Local name="a21" type="num" xsi:type="array" size="1" />
      <Local name="a22" type="num" xsi:type="array" size="1" />
      <Local name="a23" type="num" xsi:type="array" size="1" />
      <Local name="a24" type="num" xsi:type="array" size="1" />
      <Local name="a31" type="num" xsi:type="array" size="1" />
      <Local name="a32" type="num" xsi:type="array" size="1" />
      <Local name="a33" type="num" xsi:type="array" size="1" />
      <Local name="a34" type="num" xsi:type="array" size="1" />
      <Local name="a41" type="num" xsi:type="array" size="1" />
      <Local name="a42" type="num" xsi:type="array" size="1" />
      <Local name="a43" type="num" xsi:type="array" size="1" />
      <Local name="a44" type="num" xsi:type="array" size="1" />
      <Local name="i" type="num" xsi:type="array" size="1" />
      <Local name="j" type="num" xsi:type="array" size="1" />
      <Local name="A" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //初始化变量
  a11=x_nMatrixOrigin[0,0]
  a21=x_nMatrixOrigin[0,1]
  a31=x_nMatrixOrigin[0,2]
  a41=x_nMatrixOrigin[0,3]
  a12=x_nMatrixOrigin[1,0]
  a22=x_nMatrixOrigin[1,1]
  a32=x_nMatrixOrigin[1,2]
  a42=x_nMatrixOrigin[1,3]
  a13=x_nMatrixOrigin[2,0]
  a23=x_nMatrixOrigin[2,1]
  a33=x_nMatrixOrigin[2,2]
  a43=x_nMatrixOrigin[2,3]
  a14=x_nMatrixOrigin[3,0]
  a24=x_nMatrixOrigin[3,1]
  a34=x_nMatrixOrigin[3,2]
  a44=x_nMatrixOrigin[3,3]

  //求代数余子式
  A11=power(-1,1+1)*(a22*a33*a44+a23*a34*a42+a24*a32*a43-a22*a34*a43-a23*a32*a44-a24*a33*a42)
  A12=power(-1,1+2)*(a21*a33*a44+a23*a34*a41+a24*a31*a43-a21*a34*a43-a23*a31*a44-a24*a33*a41)
  A13=power(-1,1+3)*(a21*a32*a44+a22*a34*a41+a24*a31*a42-a21*a34*a42-a22*a31*a44-a24*a32*a41)
  A14=power(-1,1+4)*(a21*a32*a43+a22*a33*a41+a23*a31*a42-a21*a33*a42-a22*a31*a43-a23*a32*a41)
  //
  A21=power(-1,2+1)*(a12*a33*a44+a13*a34*a42+a14*a32*a43-a12*a34*a43-a13*a32*a44-a14*a33*a42)
  A22=power(-1,2+2)*(a11*a33*a44+a13*a34*a41+a14*a31*a43-a11*a34*a43-a13*a31*a44-a14*a33*a41)
  A23=power(-1,2+3)*(a11*a32*a44+a12*a34*a41+a14*a31*a42-a11*a34*a42-a12*a31*a44-a14*a32*a41)
  A24=power(-1,2+4)*(a11*a32*a43+a12*a33*a41+a13*a31*a42-a11*a33*a42-a12*a31*a43-a13*a32*a41)
  //
  A31=power(-1,3+1)*(a12*a23*a44+a13*a24*a42+a14*a22*a43-a12*a24*a43-a13*a22*a44-a14*a23*a42)
  A32=power(-1,3+2)*(a11*a23*a44+a13*a24*a41+a14*a21*a43-a11*a24*a43-a13*a21*a44-a14*a23*a41)
  A33=power(-1,3+3)*(a11*a22*a44+a12*a24*a41+a14*a21*a42-a11*a24*a42-a12*a21*a44-a14*a22*a41)
  A34=power(-1,3+4)*(a11*a22*a43+a12*a23*a41+a13*a21*a42-a11*a23*a42-a12*a21*a43-a13*a22*a41)
  //
  A41=power(-1,4+1)*(a12*a23*a34+a13*a24*a32+a14*a22*a33-a12*a24*a33-a13*a22*a34-a14*a23*a32)
  A42=power(-1,4+2)*(a11*a23*a34+a13*a24*a31+a14*a21*a33-a11*a24*a33-a13*a21*a34-a14*a23*a31)
  A43=power(-1,4+3)*(a11*a22*a34+a12*a24*a31+a14*a21*a32-a11*a24*a32-a12*a21*a34-a14*a22*a31)
  A44=power(-1,4+4)*(a11*a22*a33+a12*a23*a31+a13*a21*a32-a11*a23*a32-a12*a21*a33-a13*a22*a31)

  //求行列式的值
  A=a11*A11+a12*A12+a13*A13+a14*A14
  

  if abs(A)<0.001
    //逆矩阵不存在
    x_bStatus=false
    for i=0 to 3
      for j=0 to 3
        x_nMatrixNew[i,j]=0
      endFor
    endFor
  else
    //逆矩阵存在
    x_bStatus=true
    x_nMatrixNew[0,0]=A11/A
    x_nMatrixNew[0,1]=A12/A
    x_nMatrixNew[0,2]=A13/A
    x_nMatrixNew[0,3]=A14/A
    x_nMatrixNew[1,0]=A21/A
    x_nMatrixNew[1,1]=A22/A
    x_nMatrixNew[1,2]=A23/A
    x_nMatrixNew[1,3]=A24/A
    x_nMatrixNew[2,0]=A31/A
    x_nMatrixNew[2,1]=A32/A
    x_nMatrixNew[2,2]=A33/A
    x_nMatrixNew[2,3]=A34/A
    x_nMatrixNew[3,0]=A41/A
    x_nMatrixNew[3,1]=A42/A
    x_nMatrixNew[3,2]=A43/A
    x_nMatrixNew[3,3]=A44/A
  endIf
end]]></Code>
  </Program>
</Programs>