<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="checkPoint" access="public">
    <Locals>
      <Local name="l_nSize" type="num" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_pPoint" type="pointRx" xsi:type="array" size="1" />
      <Local name="l_bErr" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  l_pPoint=here(flange,world)
  l_nSize=size(safeData:sSPoint)
  for l_i = 0 to l_nSize-1
    if safeData:sSPoint[l_i].bActive
      if distance(safeData:sSPoint[l_i].pPointRx.trsf,l_pPoint.trsf)<5
        call io:setDigOutput(io:dOutput[l_i+96],true,l_bErr)
      else
        call io:setDigOutput(io:dOutput[l_i+96],false,l_bErr)
      endIf
    endIf
  endFor
end]]></Code>
  </Program>
</Programs>