<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="moveRecPos">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_sTarget" type="string" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_bTaskStatusErr" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if taskStatus("m")!=-1
    taskKill("m")
  endIf
  if taskStatus("m")==-1
    taskCreate "m",100, db:ListMove(x_sTarget)
  endIf
  l_bTaskStatusErr=watch(taskStatus("m")==150 or taskStatus("m")>1,0.3)
  if l_bTaskStatusErr==true
    taskKill("m")
    call db:hmiAlert("CantMove2","warning") 
  endIf
end

]]></Code>
  </Program>
</Programs>