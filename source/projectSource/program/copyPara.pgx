<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="copyPara" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_sTarget" type="string" xsi:type="element" />
      <Parameter name="x_nSource" type="num" xsi:type="element" />
      <Parameter name="x_nTarget" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_nSize" type="num" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_j" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin

  progTemp:pProgItem[x_sTarget].pProgTemplate[x_nTarget].sTRAJname=progTemp:pProgItem[x_sTarget].pProgTemplate[x_nSource].sTRAJname
  progTemp:pProgItem[x_sTarget].pProgTemplate[x_nTarget].nType=progTemp:pProgItem[x_sTarget].pProgTemplate[x_nSource].nType
  for l_j=0 to 2
    progTemp:pProgItem[x_sTarget].pProgTemplate[x_nTarget].iIfItem.nSigType[l_j]=progTemp:pProgItem[x_sTarget].pProgTemplate[x_nSource].iIfItem.nSigType[l_j]
    progTemp:pProgItem[x_sTarget].pProgTemplate[x_nTarget].iIfItem.nSigIndex[l_j]=progTemp:pProgItem[x_sTarget].pProgTemplate[x_nSource].iIfItem.nSigIndex[l_j]
    progTemp:pProgItem[x_sTarget].pProgTemplate[x_nTarget].iIfItem.nValue[l_j]=progTemp:pProgItem[x_sTarget].pProgTemplate[x_nSource].iIfItem.nValue[l_j]
  endFor
  progTemp:pProgItem[x_sTarget].pProgTemplate[x_nTarget].iIfItem.bANDOR[0]=(progTemp:pProgItem[x_sTarget].pProgTemplate[x_nSource].iIfItem.bANDOR[0]==true)
  progTemp:pProgItem[x_sTarget].pProgTemplate[x_nTarget].iIfItem.bANDOR[1]=(progTemp:pProgItem[x_sTarget].pProgTemplate[x_nSource].iIfItem.bANDOR[1]==true)

end]]></Code>
  </Program>
</Programs>