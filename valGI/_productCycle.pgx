    case 40
      rs:sTrajStatus="开始执行prod40"
      call prog:makeTraj("prod40")

    break
    case 41
      rs:sTrajStatus="开始执行prod41"
      call prog:makeTraj("prod41")

    break
    case 42
      rs:sTrajStatus="开始执行prod042"
      call prog:makeTraj("prod42")

    break
    case 43
      rs:sTrajStatus="开始执行prod43"
      call prog:makeTraj("prod43")

    break
    case 44
      rs:sTrajStatus="开始执行prod44"
      call prog:makeTraj("prod44")

    break
    case 45
      rs:sTrajStatus="开始执行prod45"
