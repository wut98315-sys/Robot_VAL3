<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="main" access="public">
    <Code><![CDATA[begin
  //start
  call iolink()
  
  //main loop
  do
    call safePointCheck()
    
    
    call safeZoneCheck()
    
    
    delay(0)
  until false
end]]></Code>
  </Program>
</Programs>