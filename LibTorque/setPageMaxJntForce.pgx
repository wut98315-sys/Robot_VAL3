<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="setPageMaxJntForce" access="public">
    <Locals>
      <Local name="i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //页面修改扭矩库限值
  if sArmType=="4_Axis"
    for i=0 to 3
      forcedata:tArm4Force[sArmDetail].nMaxJnt4Force[i]=nMaxJntForce[i]
    endFor
  elseIf sArmType=="6_Axis"
    for i=0 to 5
      forcedata:tArm6Force[sArmDetail].nMaxJnt6Force[i]=nMaxJntForce[i]
    endFor
  endIf
  forcedata:libSave()
  delay(0.1)
end]]></Code>
  </Program>
</Programs>