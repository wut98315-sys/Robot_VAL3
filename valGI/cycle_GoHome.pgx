<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="cycle_GoHome">
    <Locals>
      <Local name="l_tTool" type="tool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  rs:_nOmacStat=12
  // Stop task
  taskKill("Reset")
  taskKill("Start")
  taskKill("Stop")
  taskKill("End")
  taskKill("Monitor1")
  taskKill("RotGoHome")
  taskKill("productCycle")

  wait(isSettled())

  if !isPowered()
    popUpMsg("请先上电！")
    rs:_nOmacStat=9
    return
  endIf

  resetMotion()
  //2024.11.22 add初始化回零堆栈
  call ar:resetReturnStack(false)
  rs:sTrajStatus="直接回原点过程中"
  taskCreate "Monitor",20,MonitorIO()
  wait(taskStatus("Monitor")==1)
  link(l_tTool,flange)
  call saveData:getTool(1,l_tTool)
  movej(saveData:jHome,l_tTool,mHome)
  waitEndMove()
  ar:bInterrupt=false
  bGetMovId=false
  rs:sTrajStatus="直接回原点完成"

  taskKill("Monitor")
  wait(taskStatus("Monitor")<0)
  disablePower()
  rs:_nOmacStat=9
  delay(0)

end]]></Code>
  </Program>
</Programs>