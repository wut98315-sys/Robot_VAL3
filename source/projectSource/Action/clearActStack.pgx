<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="clearActStack" access="public">
    <Locals>
      <Local name="l_n" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  for l_n=0 to size(_nPuleStartClk)-1
    _nPuleStartClk[l_n]=-1
  endFor
  _nActStackIndex=0
  for l_n=0 to size(actCmd)-1
    call removeActCmd(l_n)
  endFor
end]]></Code>
  </Program>
</Programs>