      rs:sTrajStatus="开始执行prod09"
      call prog:makeTraj("prod09")

    break
    case 10
      rs:sTrajStatus="开始执行prod10"
      call prog:makeTraj("prod10")

    break
    case 11
      rs:sTrajStatus="开始执行prod11"
      call prog:makeTraj("prod11")

    break
    case 12
      rs:sTrajStatus="开始执行prod012"
      call prog:makeTraj("prod12")

    break
    case 13
      rs:sTrajStatus="开始执行prod13"
      call prog:makeTraj("prod13")

    break
    case 14
      rs:sTrajStatus="开始执行prod14"
      call prog:makeTraj("prod14")

    break
    case 15
      rs:sTrajStatus="开始执行prod15"
      call prog:makeTraj("prod15")

    break
    case 16
      rs:sTrajStatus="开始执行prod16"
      call prog:makeTraj("prod16")

    break


    case 17
      rs:sTrajStatus="开始执行prod17"
      call prog:makeTraj("prod17")
    break

    case 18
      rs:sTrajStatus="开始执行prod18"
      call prog:makeTraj("prod18")
    break
    case 19
      rs:sTrajStatus="开始执行prod19"
      call prog:makeTraj("prod19")
    break

    case 20
      rs:sTrajStatus="开始执行prod20"
      call prog:makeTraj("prod20")
    break
    
    case 21
      rs:sTrajStatus="开始执行prod21"
      call prog:makeTraj("prod21")

    break
    case 22
      rs:sTrajStatus="开始执行prod22"
      call prog:makeTraj("prod22")

    break
    case 23
      rs:sTrajStatus="开始执行prod23"
      call prog:makeTraj("prod23")

    break
    case 24
      rs:sTrajStatus="开始执行prod24"
      call prog:makeTraj("prod24")

    break
    case 25
      rs:sTrajStatus="开始执行prod25"
      call prog:makeTraj("prod25")

    break
    case 26
      rs:sTrajStatus="开始执行prod26"
      call prog:makeTraj("prod26")

    break
    case 27
      rs:sTrajStatus="开始执行prod27"
