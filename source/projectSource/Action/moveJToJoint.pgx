<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="moveJToJoint" access="public">
    <Description><![CDATA[ //作用：用关节运动的方式移动到目标点。
  //参数： 
  //x_jTarget: 目标点Joint值
  //  x_tTool：去目标点使用的工具值
  //  x_mSpeed:去目标点使用的速度值
  //x_bWaitEndmove:到达目标点，没有混合，为true则是严格到达目标点]]></Description>
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_jTarget" type="joint" xsi:type="element" />
      <Parameter name="x_tTool" type="tool" xsi:type="element" />
      <Parameter name="x_mSpeed" type="mdesc" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_bInRange" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //作用：用关节运动的方式移动到目标点。
  //参数： 
  //x_jTarget: 目标点Joint值
  //  x_tTool：去目标点使用的工具值
  //  x_mSpeed:去目标点使用的速度值
  //  x_bWaitEndmove:到达目标点，没有混合，为true则是严格到达目标点
 
  l_bInRange=isInRange(x_jTarget)
  if l_bInRange==true
    nMoveIDRef=movej(x_jTarget,x_tTool,x_mSpeed)
    call checkMoveId()
  else
    //超出机器人限位
    call rs:setAlarm(221,-1)
  endIf
  
end]]></Code>
  </Program>
</Programs>