<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="areaCheck" access="public">
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  for l_i = 0 to size(safeData:zZoneItem)-1
    if safeData:zZoneItem[l_i].bActive
      call computeArea(l_i)
    endIf
  endFor
  
end]]></Code>
  </Program>
</Programs>