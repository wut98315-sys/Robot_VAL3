<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_productCycle" access="public">
    <Locals>
      <Local name="l_bErr" type="bool" xsi:type="array" size="1" />
      <Local name="l_bStartClock" type="bool" xsi:type="array" size="1" />
      <Local name="l_nClock" type="num" xsi:type="array" size="1" />
      <Local name="l_nLastAct" type="num" xsi:type="array" size="1" />
      <Local name="l_nLibIndex" type="num" xsi:type="array" size="1" />
      <Local name="l_sPath" type="string" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //do
  // rs:nPLCcmd=0
  //等待数据库切换完成以及程序号完成
  // wait(io:dInput[30]==true)
  //wait(bBool==true)
  //
  waitEndMove()
  //
  //（工作号&程序号->切换完成->plc启动信号->productcycle->（工作号&程序号->切换完成->plc启动信号
  //
  //获取程序号
  call io:getAnaIO(io:aInItem[0].aAio,rs:nProgCode,l_bErr)
  switch rs:nProgCode
    case 0
      //call prog:makeTraj("test")
    break
    case 1
      rs:sTrajStatus="开始执行prod01"
      call prog:makeTraj("prod01")

    break
    case 2
      rs:sTrajStatus="开始执行prod02"
      call prog:makeTraj("prod02")

    break
    case 3
      rs:sTrajStatus="开始执行prod03"
      call prog:makeTraj("prod03")

    break
    case 4
      rs:sTrajStatus="开始执行prod04"
      call prog:makeTraj("prod04")

    break
    case 5
      rs:sTrajStatus="开始执行prod05"
      call prog:makeTraj("prod05")

    break
    case 6
      rs:sTrajStatus="开始执行prod06"
      call prog:makeTraj("prod06")

    break
    case 7
      rs:sTrajStatus="开始执行prod07"
      call prog:makeTraj("prod07")

    break
