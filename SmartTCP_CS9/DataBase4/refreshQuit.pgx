<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="refreshQuit" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_bOut" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Code><![CDATA[begin
  //Quit
  if utBtn_Step[0].Events.bClick==false and  utBtn_Step[1].Events.bClick==false and utBtn_Step[2].Events.bClick==false
    if utBtn_Bottom[7].Events.bClick==true
      utBtn_Bottom[7].Events.bClick=false
      //Press F7      
      call hmiConfirm("Quit","confirm",x_bOut)        
    endIf
  endIf
end
]]></Code>
  </Program>
</Programs>