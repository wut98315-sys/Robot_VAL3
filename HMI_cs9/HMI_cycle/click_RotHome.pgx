<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="click_RotHome">
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if workingMode()!=1
    popUpMsg("非手动模式不支持路径回原！")
    return
  endIf
  //手动机器人路径回原
  l_bResult=userPageConfirm("确认原路径返回Home？")
  if l_bResult
    rs:nCycleCmd=7
    delay(0.2)
    rs:nCycleCmd=0
  endIf

end]]></Code>
  </Program>
</Programs>