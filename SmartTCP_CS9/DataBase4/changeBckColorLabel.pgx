<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="changeBckColorLabel" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_uUtLabel" type="utLabel" xsi:type="element" />
      <Parameter name="x_sColor" type="string" xsi:type="element" />
    </Parameters>
    <Code><![CDATA[begin
  // change the BackGround color -> using userPageSet
  userPageSet(x_uUtLabel.Common.sPage,x_uUtLabel.Common.sID,"style.backgroundColor",x_sColor)
end]]></Code>
  </Program>
</Programs>