<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="setDigOutNoAlm" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_dOut" type="dio" xsi:type="element" use="reference" />
      <Parameter name="x_bValue" type="bool" xsi:type="element" />
      <Parameter name="x_bError" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Code><![CDATA[begin
  if ioStatus(x_dOut)>=0
    x_bError=false
    x_dOut=x_bValue
  else
    x_bError=true
  endIf

end]]></Code>
  </Program>
</Programs>