<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="Atan2" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="y" type="num" xsi:type="element" />
      <Parameter name="x" type="num" xsi:type="element" />
      <Parameter name="angle" type="num" xsi:type="element" use="reference" />
    </Parameters>
    <Code><![CDATA[begin
  //双变量反正切函数atan2(x,y)
  if x>0 
    angle=atan(y/x)
  elseIf y>=0 and x<0
    angle=atan(y/x)+180
  elseIf y<0 and x<0
    angle=atan(y/x)-180
  elseIf y>0 and x==0
    angle=90
  elseIf y<0 and x==0
    angle=-90
  elseIf y==0 and x==0
    //Undefined
  endIf
end
]]></Code>
  </Program>
</Programs>