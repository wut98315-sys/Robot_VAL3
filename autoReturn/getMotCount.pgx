<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="getMotCount" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_bContain" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_nI" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  x_bContain=false
  for l_nI= 0 to size(nMoveTypeRec)-1
    if nMoveTypeRec[l_nI]!=-1 and nMoveIdRec[l_nI]!=-1
      x_bContain=true
    endIf
  endFor
end]]></Code>
  </Program>
</Programs>