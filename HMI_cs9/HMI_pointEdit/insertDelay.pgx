<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="insertDelay" access="public">
    <Locals>
      <Local name="l_bExit" type="bool" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_nPoint" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  do
    
    if util:sPage!="insertDelay"
      util:sPage="insertDelay"
      nSetDelay=0
      userPageBindClick("insertDelay","btn1",bConfirmDelay,true)
      userPageBindClick("insertDelay","btn2",bBackDelay,true)
      userPageBind("insertDelay","nmb1","value",nSetDelay,1,"rw")
      userPage(util:sPage)
      delay(0.5)
      
    endIf
    
    
    if bConfirmDelay
      bConfirmDelay=false
       call trajectory:getPointIndex(sTrajItem,sSelPoint,l_nPoint,l_bResult)
      call trajectory:insertDelay(sTrajItem,l_nPoint,bToSave,7,nSetDelay)
      l_bExit=true
      
    elseIf bBackDelay
      bBackDelay=false
      l_bExit=true
    endIf
    
    
    
    
    delay(0)
  until l_bExit==true
end]]></Code>
  </Program>
</Programs>