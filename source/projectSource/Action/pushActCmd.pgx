<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="pushActCmd">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nMoveID" type="num" xsi:type="element" />
      <Parameter name="x_actPrt" type="actionIO" xsi:type="element" />
    </Parameters>
    <Code><![CDATA[begin
  //add to action stack, excute act command in actCtrl task, to optmize cycle time
  setMutex(bPushToStack)
  _nActStackIndex=(_nActStackIndex+1)%size(actCmd)
  if actCmd[_nActStackIndex].nMoveID<0
    actCmd[_nActStackIndex].nMoveID=x_nMoveID
    actCmd[_nActStackIndex].nActionID =_nActStackIndex
    actPrt[_nActStackIndex]=x_actPrt
  else
    call rs:setAlarm(201,-1)
  endIf
  bPushToStack=false
end]]></Code>
  </Program>
</Programs>