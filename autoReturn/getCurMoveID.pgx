<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="getCurMoveID" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_bGetMoveId" type="bool" xsi:type="element" />
      <Parameter name="x_sType" type="string" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_bGetMoveId" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  l_bGetMoveId=(x_bGetMoveId==true)
  if !l_bGetMoveId
    if(x_sType=="Stop" or x_sType=="Abort" or x_sType=="End") and !bHaveGetMoveID
      nCurrentMoveID=getMoveId()
      bHaveGetMoveID=true
    endIf
    // bInterrupt=true
  else
    bInterrupt=true
  endIf
end]]></Code>
  </Program>
</Programs>