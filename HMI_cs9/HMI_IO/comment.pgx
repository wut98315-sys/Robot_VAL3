<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="comment" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_bRefresh" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_sString" type="string" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_nIndex" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  for l_i = 0 to size(bComment)-1
    if bComment[l_i]
      bComment[l_i]=false
      l_bResult=userPagePrompt("注释：",l_sString)
      if l_bResult
        l_nIndex=nPageIndex*16+l_i
        //Modify by Liu Zhengang 20251103
        switch nSelType
          case 0,1
            if 15<l_nIndex and l_nIndex<96
              call IOcomment(nSelType,l_nIndex,l_sString)
            else
              userPageAlert("此信号不可修改注释！")
            endIf
            io:libSave()
            delay(0.1)
            x_bRefresh=true
          break
          case 2,3
            if 4<l_nIndex and l_nIndex<20
              call IOcomment(nSelType,l_nIndex,l_sString)
            else
              userPageAlert("此信号不可修改注释！")
            endIf
            io:libSave()
            delay(0.1)
            x_bRefresh=true
          break
        endSwitch
      endIf
    endIf
  endFor
end]]></Code>
  </Program>
</Programs>