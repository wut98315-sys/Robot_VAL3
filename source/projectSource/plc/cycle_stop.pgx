<?xml version="1.0" encoding="utf-8" ?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2" >
  <Program name="cycle_stop" access="public" >
    <Code><![CDATA[begin
  rs:bToStopCycle=true
  stopMove()
  wait(rs:bIsCycle==false)
  rs:bToStopCycle=false
  logMsg("PLC:stopcycle")
end]]></Code>
  </Program>
</Programs>