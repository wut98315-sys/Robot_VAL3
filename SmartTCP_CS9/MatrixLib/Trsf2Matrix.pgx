<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="Trsf2Matrix" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_trTrsf" type="trsf" xsi:type="element" />
      <Parameter name="x_nMatrix" type="num" xsi:type="array" use="reference" dimensions="2" />
    </Parameters>
    <Locals>
      <Local name="ax" type="num" xsi:type="array" size="1" />
      <Local name="ay" type="num" xsi:type="array" size="1" />
      <Local name="az" type="num" xsi:type="array" size="1" />
      <Local name="nx" type="num" xsi:type="array" size="1" />
      <Local name="ny" type="num" xsi:type="array" size="1" />
      <Local name="nz" type="num" xsi:type="array" size="1" />
      <Local name="ox" type="num" xsi:type="array" size="1" />
      <Local name="oy" type="num" xsi:type="array" size="1" />
      <Local name="oz" type="num" xsi:type="array" size="1" />
      <Local name="px" type="num" xsi:type="array" size="1" />
      <Local name="py" type="num" xsi:type="array" size="1" />
      <Local name="pz" type="num" xsi:type="array" size="1" />
      <Local name="rx" type="num" xsi:type="array" size="1" />
      <Local name="ry" type="num" xsi:type="array" size="1" />
      <Local name="rz" type="num" xsi:type="array" size="1" />
      <Local name="x" type="num" xsi:type="array" size="1" />
      <Local name="y" type="num" xsi:type="array" size="1" />
      <Local name="z" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //Trsf转换成Matrik
  x=x_trTrsf.x
  y=x_trTrsf.y
  z=x_trTrsf.z
  rx=x_trTrsf.rx
  ry=x_trTrsf.ry
  rz=x_trTrsf.rz
  //
  nx=cos(ry)*cos(rz)
  ny=sin(rx)*sin(ry)*cos(rz)+cos(rx)*sin(rz)
  nz=-cos(rx)*sin(ry)*cos(rz)+sin(rx)*sin(rz)
  ox=-cos(ry)*sin(rz)
  oy=-sin(rx)*sin(ry)*sin(rz)+cos(rx)*cos(rz)
  oz=cos(rx)*sin(ry)*sin(rz)+sin(rx)*cos(rz)
  ax=sin(ry)
  ay=-sin(rx)*cos(ry)
  az=cos(rx)*cos(ry)
  px=x
  py=y
  pz=z
  //
  x_nMatrix[0,0]=nx
  x_nMatrix[0,1]=ny
  x_nMatrix[0,2]=nz
  x_nMatrix[0,3]=0
  x_nMatrix[1,0]=ox
  x_nMatrix[1,1]=oy
  x_nMatrix[1,2]=oz
  x_nMatrix[1,3]=0
  x_nMatrix[2,0]=ax
  x_nMatrix[2,1]=ay
  x_nMatrix[2,2]=az
  x_nMatrix[2,3]=0
  x_nMatrix[3,0]=px
  x_nMatrix[3,1]=py
  x_nMatrix[3,2]=pz
  x_nMatrix[3,3]=1
end]]></Code>
  </Program>
</Programs>