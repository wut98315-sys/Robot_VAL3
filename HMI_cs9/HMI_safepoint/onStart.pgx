<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="onStart" access="public">
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  call saveData:setBaseJOG(saveData:nJogTool)
  resize(sList,1,size(safeTemp:sSPoint))
  for l_i = 0 to size(sList)-1
    sList[l_i]=toString("",l_i)+","+safeTemp:sSPoint[l_i].sName
  endFor
  
  sSelPoint=""
  sLastPoint=""
  bActive=false
  
  for l_i = 0 to size(sTRSF)-1
    sTRSF[l_i]=""
  endFor
  
end]]></Code>
  </Program>
</Programs>