<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_CalpSphere">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_p1" type="point" xsi:type="element" />
      <Parameter name="x_p2" type="point" xsi:type="element" />
      <Parameter name="x_p3" type="point" xsi:type="element" />
      <Parameter name="x_p4" type="point" xsi:type="element" />
      <Parameter name="x_pCenter" type="point" xsi:type="element" use="reference" />
      <Parameter name="x_bStatus" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="x1" type="num" xsi:type="array" size="1" />
      <Local name="x2" type="num" xsi:type="array" size="1" />
      <Local name="x3" type="num" xsi:type="array" size="1" />
      <Local name="x4" type="num" xsi:type="array" size="1" />
      <Local name="y1" type="num" xsi:type="array" size="1" />
      <Local name="y2" type="num" xsi:type="array" size="1" />
      <Local name="y3" type="num" xsi:type="array" size="1" />
      <Local name="y4" type="num" xsi:type="array" size="1" />
      <Local name="z1" type="num" xsi:type="array" size="1" />
      <Local name="z2" type="num" xsi:type="array" size="1" />
      <Local name="z3" type="num" xsi:type="array" size="1" />
      <Local name="z4" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //球心算法  
  x1=x_p1.trsf.x
  y1=x_p1.trsf.y
  z1=x_p1.trsf.z

  x2=x_p2.trsf.x
  y2=x_p2.trsf.y
  z2=x_p2.trsf.z

  x3=x_p3.trsf.x
  y3=x_p3.trsf.y
  z3=x_p3.trsf.z

  x4=x_p4.trsf.x
  y4=x_p4.trsf.y
  z4=x_p4.trsf.z

  //构造矩阵nMatrix1
  nMatrix1[0,0]=x2-x1
  nMatrix1[0,1]=x3-x1
  nMatrix1[0,2]=x4-x1
  nMatrix1[0,3]=0
  nMatrix1[1,0]=y2-y1
  nMatrix1[1,1]=y3-y1
  nMatrix1[1,2]=y4-y1
  nMatrix1[1,3]=0
  nMatrix1[2,0]=z2-z1
  nMatrix1[2,1]=z3-z1
  nMatrix1[2,2]=z4-z1
  nMatrix1[2,3]=0
  nMatrix1[3,0]=0
  nMatrix1[3,1]=0
  nMatrix1[3,2]=0
  nMatrix1[3,3]=1



  //构造矩阵nMatrix2
  nMatrix2[0,0]=1
  nMatrix2[0,1]=0
  nMatrix2[0,2]=0
  nMatrix2[0,3]=0

  nMatrix2[1,0]=0
  nMatrix2[1,1]=1
  nMatrix2[1,2]=0
  nMatrix2[1,3]=0

  nMatrix2[2,0]=0
  nMatrix2[2,1]=0
  nMatrix2[2,2]=1
  nMatrix2[2,3]=0

  nMatrix2[3,0]=(x2*x2+y2*y2+z2*z2-x1*x1-y1*y1-z1*z1)/2
  nMatrix2[3,1]=(x3*x3+y3*y3+z3*z3-x1*x1-y1*y1-z1*z1)/2
  nMatrix2[3,2]=(x4*x4+y4*y4+z4*z4-x1*x1-y1*y1-z1*z1)/2
  nMatrix2[3,3]=1

  call matrix:InverseMatrix(nMatrix1,nInverseMatrix1,x_bStatus)
  if x_bStatus==true
    //矩阵nMatrix1的逆矩阵nInverseMatrik1存在
    call matrix:MutliMatrix(nInverseMatrix1,nMatrix2,nMatrix3)
  endIf

  x_pCenter.trsf.x=nMatrix3[3,0]
  x_pCenter.trsf.y=nMatrix3[3,1]
  x_pCenter.trsf.z=nMatrix3[3,2]

end]]></Code>
  </Program>
</Programs>