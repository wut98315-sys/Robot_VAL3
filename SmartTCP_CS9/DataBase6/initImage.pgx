<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="initImage" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_utImage" type="utImage" xsi:type="array" use="reference" />
      <Parameter name="x_sPage" type="string" xsi:type="element" />
      <Parameter name="x_sId" type="string" xsi:type="element" />
    </Parameters>
    <Code><![CDATA[begin
  x_utImage.Common.sPage=x_sPage
  x_utImage.Common.sID=x_sId
  userPageBind(x_utImage.Common.sPage,x_utImage.Common.sID,"src",x_utImage.Common.sSourceImage,1,"r")
  userPageBind(x_utImage.Common.sPage,x_utImage.Common.sID,"style.visibility",x_utImage.Appearance.bVisibility,1,"r")
  userPageBindClick(x_utImage.Common.sPage,x_utImage.Common.sID,x_utImage.Events.bClick,true)
  //
  userPageBind(x_utImage.Common.sPage,x_utImage.Common.sID,"className",x_utImage.Common.sClass,1,"r")
  //userPageBind(x_sPage,x_utImage.Common.sID,"style.borderColor",x_utImage.Border.sBorderColour,1,"r")
  //userPageBind(x_sPage,x_utImage.Common.sID,"style.borderStyle",x_utImage.Border.sBorderStyle,1,"r")
  //
  x_utImage.Appearance.bVisibility=true
  x_utImage.Events.bClick=false
  x_utImage.Common.sClass="clickable"
end]]></Code>
  </Program>
</Programs>