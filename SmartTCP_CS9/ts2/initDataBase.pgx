  db:mSpeed_C_blend.reach=0
  //
  db:mSpeed_J_blend.tvel=250
  db:mSpeed_J_blend.blend=joint
  db:mSpeed_J_blend.leave=5
  db:mSpeed_J_blend.reach=5
  //
  db:mSlow.tvel=30
  db:mSlow.blend=Cartesian
  db:mSlow.leave=0
  db:mSlow.reach=0
  //
  db:cConfigSame={ssame}
  //  
  //pTeach1.trsf={0,0,0,0,0,0}
  db:pTeach1.config={ssame}
  //pTeach2.trsf={0,0,0,0,0,0}
  db:pTeach2.config={ssame}
  //pTeach3.trsf={0,0,0,0,0,0}
  db:pTeach3.config={ssame}
  //pTeach4.trsf={0,0,0,0,0,0}
  db:pTeach4.config={ssame}
  //pTeach5.trsf={0,0,0,0,0,0}
  db:pTeach5.config={ssame}
  //pTeach6.trsf={0,0,0,0,0,0}
  db:pTeach6.config={ssame}
  //
  //pAdjustXY_2_1.trsf={0,0,0,0,0,0}
  db:pAdjustXY_2_1.config={ssame}
  //pAdjustXY_2_2.trsf={0,0,0,0,0,0}
  db:pAdjustXY_2_2.config={ssame}
  //pAdjustXY_3_1.trsf={0,0,0,0,0,0}
  db:pAdjustXY_3_1.config={ssame}
  //pAdjustXY_3_2.trsf={0,0,0,0,0,0}
  db:pAdjustXY_3_2.config={ssame}
  //pAdjustXY_3_3.trsf={0,0,0,0,0,0}
  db:pAdjustXY_3_3.config={ssame}
  //
  db:bTeach1=false
  db:bTeach2=false
  db:bTeach3=false
  db:bTeach4=false
  db:bTeach5=false
  db:bTeach6=false
  //
  db:bAdjustXY_2_1=false
  db:bAdjustXY_2_2=false
  db:bAdjustXY_3_1=false
  db:bAdjustXY_3_2=false
  db:bAdjustXY_3_3=false
  //
  db:sLanguageM=""
  db:sCbxLanguage=""
  db:sCbxMounting=""
end]]></Code>
  </Program>
