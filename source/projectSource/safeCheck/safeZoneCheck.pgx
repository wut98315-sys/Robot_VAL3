<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="safeZoneCheck" access="public">
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_bErr" type="bool" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  for l_i = 0 to size(safeTemp:zZoneItem)-1
    if safeTemp:zZoneItem[l_i].bActive
      call computeZone(l_i,l_bResult)
      call io:setDigOutput(O_safeZone[l_i],l_bResult,l_bErr)
    endIf
  endFor
end]]></Code>
  </Program>
</Programs>