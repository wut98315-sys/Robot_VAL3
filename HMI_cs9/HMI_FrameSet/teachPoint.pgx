<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="teachPoint">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nStep" type="num" xsi:type="element" />
      <Parameter name="x_nIndex" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  l_bResult=userPageConfirm("是否记录该点位？")
  if l_bResult
    switch x_nStep
      case 0
        savedata:fFrameItem[x_nIndex].pPointRx[0]=here(tUsingTool,world)
      break
      case 1
        savedata:fFrameItem[x_nIndex].pPointRx[1]=here(tUsingTool,world)
      break
      case 2
        savedata:fFrameItem[x_nIndex].pPointRx[2]=here(tUsingTool,world)
      break
    
    endSwitch
  endIf
end]]></Code>
  </Program>
</Programs>