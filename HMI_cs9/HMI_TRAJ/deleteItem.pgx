<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="deleteItem" access="public">
    <Locals>
      <Local name="l_sMsg" type="string" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if sSelTraj!=""
    l_sMsg="是否删除："+sSelTraj+"?"
    l_bResult=userPageConfirm(l_sMsg)
    if l_bResult
      call trajectory:deleteTraj(sSelTraj,bToSave)
      //call trajectory:getTrajList(sList)
    endIf
  else
    userPageAlert("未选中任意项目！")
  endIf
end]]></Code>
  </Program>
</Programs>