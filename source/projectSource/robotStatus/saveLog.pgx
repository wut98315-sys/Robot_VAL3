<?xml version="1.0" encoding="utf-8" ?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2" >
  <Program name="saveLog" access="public" >
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1" >
      <Parameter name="x_sPath" type="string" use="value" xsi:type="element" dimensions="1" />
      <Parameter name="x_nResult" type="num" use="reference" xsi:type="element" dimensions="1" />
    </Parameters>
    <Locals>
      <Local name="l_n" type="num" xsi:type="array" size="1" />
      <Local name="l_nLogMsgIndex" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if x_sPath==""
    x_nResult=Log:libSave()
  else
    x_nResult=Log:libSave(x_sPath)
  endIf
  delay(0.5)
end]]></Code>
  </Program>
</Programs>