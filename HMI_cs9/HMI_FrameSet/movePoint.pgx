<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="movePoint">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nStep" type="num" xsi:type="element" />
      <Parameter name="x_nIndex" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //   l_bResult=userPageConfirm("是否移动到该点位？")
  //  if l_bResult
  resetMotion()
  $jogMode(0)
  switch x_nStep
    case 0
      movel(savedata:fFrameItem[x_nIndex].pPointRx[0],tUsingTool,mNomSpeed)
    break
    case 1
      movel(savedata:fFrameItem[x_nIndex].pPointRx[1],tUsingTool,mNomSpeed)
    break
    case 2
      movel(savedata:fFrameItem[x_nIndex].pPointRx[2],tUsingTool,mNomSpeed)
    break
  endSwitch
  //  endIf
end]]></Code>
  </Program>
</Programs>