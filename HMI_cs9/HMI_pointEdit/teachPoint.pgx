<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="teachPoint">
    <Locals>
      <Local name="l_nPoint" type="num" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_nMoveType" type="num" xsi:type="array" size="1" />
      <Local name="l_bExit" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //2024.12.23 add 增加movec示教界面
  call trajectory:getPointIndex(sTrajItem,sSelPoint,l_nPoint,l_bResult)
  call trajectory:getMoveType(sTrajItem,l_nPoint,l_nMoveType)
  call trajectory:getFrameID(sTrajItem,_nFrameID)
  call trajectory:getToolID(sTrajItem,_nToolID)
  if l_bResult
    if l_nMoveType==0 or l_nMoveType==1
      //moveL、moveJ示教
      call trajectory:teachPoint(sTrajItem,l_nPoint,bToSave)
    elseIf l_nMoveType==2
      //进入moveC示教界面
      do
        if util:sPage!="movecTeach"
          util:sPage="movecTeach"
          sSelMovCPoint="中间点"
          userPageBindClick("movecTeach","btn1",bRecord,true)
          userPageBindClick("movecTeach","btn2",bMoveTo,true)
          userPageBindClick("movecTeach","btn3",bConfirmMovC,true)
          userPageBindClick("movecTeach","btn4",bCancelMovC,true)
          userPage(util:sPage)
          delay(0.2)
        endIf
        
        if bRecord
          bRecord=false
          if sSelMovCPoint=="中间点"
            call trajectory:teachPoint1(sTrajItem,l_nPoint,0)
            popUpMsg("圆弧中间点记录完成！")
          elseIf sSelMovCPoint=="结束点"
            call trajectory:teachPoint1(sTrajItem,l_nPoint,1)
            popUpMsg("圆弧结束点记录完成！")
          endIf
        elseIf bMoveTo
          bMoveTo=false
          if sSelMovCPoint=="中间点"
            call trajectory:pointMove1(sTrajItem,l_nPoint,0)
          elseIf sSelMovCPoint=="结束点"
            call trajectory:pointMove1(sTrajItem,l_nPoint,1)
          endIf
        elseIf bConfirmMovC
          bConfirmMovC=false
          bToSave=true
          l_bExit=true
        elseIf bCancelMovC
          bCancelMovC=false
          l_bExit=true
        endIf
        
        //jogmode
        call util:jogMode(_nToolID,_nFrameID)
        delay(0)
      until l_bExit==true
    endIf
  else
    userPageAlert("未选择有效点位！")
  endIf
end]]></Code>
  </Program>
</Programs>