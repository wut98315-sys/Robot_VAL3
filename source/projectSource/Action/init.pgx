<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="init" access="public">
    <Code><![CDATA[begin
  //更改_nPuleStartClk的大小
  if size(_nPuleStartClk)!=io:nMaxdigital
    resize(_nPuleStartClk,1,io:nMaxdigital)
    libSave()
  endIf
  //num
  _nActStackIndex=0
  //Bool
  bPushToStack=false
  //
  call clearActStack()
  //
  setMoveId(0)
end]]></Code>
  </Program>
</Programs>