<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="refreshBtn0_CaliTcp" access="public">
    <Code><![CDATA[begin
  if db:utBtn_Step[0].Events.bClick==true
    db:utCtn_Function.Common.sSource="Page_Container_Teach.html"   
    //**********************************************************************************************************************************
    //3点法标定TCP
    if db:utImg_CheckBox_a[0].Data.bStatus==true
      switch db:nStep0
        case 10
          call db:updateStr(31,db:utLbl_Point.Common.sText,"Point：P1")
          call db:updateStr(43,db:utLbl_Step.Common.sText,"Step：1/3")
          //
          db:utImg_Example.Common.sSourceImage="images/6AxisTeach_1.png"
          
          //
          call db:updateTeachPos(db:pTeach1,db:bTeach1)
          //      
          call db:updateBtn(80,"Align,Here,Move,Null,Null,Null,Prev.,Next")
          //
          call db:updateInfo(101,db:utLbl_Info0.Data.nVal,db:utLbl_Info0.Common.sText,"0","Operation reminder：")
          call db:updateInfo(102,db:utLbl_Info1.Data.nVal,db:utLbl_Info1.Common.sText,"1","Touch to reference pointer in vertical attitude")
          call db:updateInfo(105,db:utLbl_Info2.Data.nVal,db:utLbl_Info2.Common.sText,"2","Press Here button to save the position")
          call db:updateInfo(125,db:utLbl_Info3.Data.nVal,db:utLbl_Info3.Common.sText,"3","Alignment can be used when the tool and flange are 90°")
          call db:updateInfo(99,db:utLbl_Info4.Data.nVal,db:utLbl_Info4.Common.sText,"4","")
          //
          call db:updateTool(0,false)
          db:nStep0=11
        break
        //
        case 11
          if db:utBtn_Bottom[0].Events.bClick==true
            db:utBtn_Bottom[0].Events.bClick=false
            //Press F1
            call moveCalPos("Align")
          endIf
          
          if db:utBtn_Bottom[1].Events.bClick==true
            db:utBtn_Bottom[1].Events.bClick=false
            //Press F2
            db:bTeach1=true              
            db:pTeach1=here(flange,world)     
            db:jTeach1=herej()
            call db:updateTeachPos(db:pTeach1,db:bTeach1)            
            call db:hmiAlert("First","info")
            call saveCall()
          endIf
          if db:utBtn_Bottom[2].Events.bClick==true
            db:utBtn_Bottom[2].Events.bClick=false
            //Press F3
            call moveRecPos("pTeach1")
          endIf
          if db:utBtn_Bottom[6].Events.bClick==true
            db:utBtn_Bottom[6].Events.bClick=false
            //Press F7
            resetMotion()
            db:utCtn_Message.Appearance.bVisibility=false
            db:nStep0=99
          endIf
          if db:utBtn_Bottom[7].Events.bClick==true
            db:utBtn_Bottom[7].Events.bClick=false
            //Press F8
            resetMotion()
            db:utCtn_Message.Appearance.bVisibility=false
            db:nStep0=20
          endIf
        break
        //
        case 20
          call db:updateStr(32,db:utLbl_Point.Common.sText,"Point：P2")
          call db:updateStr(44,db:utLbl_Step.Common.sText,"Step：2/3")
          //
          db:utImg_Example.Common.sSourceImage="images/6AxisTeach_2.png"
          
