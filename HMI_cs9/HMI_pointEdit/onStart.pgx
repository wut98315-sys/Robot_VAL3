<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="onStart" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_sTrajItem" type="string" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_nFrameID" type="num" xsi:type="array" size="1" />
      <Local name="l_nToolID" type="num" xsi:type="array" size="1" />
      <Local name="l_nLibNum" type="num" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if sLastTrajItem!=x_sTrajItem
    nPageIndex=0
    nPointIndex=0
  endIf
  call load()
  //
  delay(0)
  sTrajItem=x_sTrajItem
  //
  
  bBack=false
  for l_i = 0 to size(bBool)-1
    bBool[l_i]=false
  endFor
  //
  for l_i = 0 to size(sList)-1
    sList[l_i]=""
  endFor
  //
  call trajectory:getFrameID(sTrajItem,l_nFrameID)
  call trajectory:getToolID(sTrajItem,l_nToolID)
  call trajectory:getLibName(l_nLibNum,l_bResult)
  call savedata:getFrame(l_nFrameID,fUsingFrame)
  call savedata:getTool(l_nToolID,tUsingTool)
  $jogContext(tUsingTool,fUsingFrame,0)
  
  sUsingFrame=toString("",l_nFrameID)
  sUsingTool=toString("",l_nToolID)
  sUsingLib=toString("",l_nLibNum)
  logMsg("<traj-jogContext> tool:"+sUsingTool+",frame:"+sUsingFrame)
  
  sSelPoint=""
  bMark=false
 
 
  
end]]></Code>
  </Program>
</Programs>