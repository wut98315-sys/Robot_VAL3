<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="_TolleranceCheck">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_bAutoConnect" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_sMsg" type="string" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin

  if bMemState and !isPowered()
    pHere1=here(flange,world)
    l_sMsg="下电位置:"+toString(".2",pHere1.trsf.x)+","+toString(".2",pHere1.trsf.y)+","+toString(".2",pHere1.trsf.rz)
    logMsg(l_sMsg)
    bMemState=false
  elseIf !bMemState and isPowered()
    pHere2=here(flange,world)
    l_sMsg="上电位置:"+toString(".2",pHere1.trsf.x)+","+toString(".2",pHere1.trsf.y)+","+toString(".2",pHere1.trsf.rz)
    logMsg(l_sMsg)
    bMemState=true
  endIf
  //check
  if distance(pHere1.trsf,pHere2.trsf)<10
    x_bAutoConnect=true
  else
    x_bAutoConnect=false
    l_sMsg="TolleranceCheck位置偏差距离过大，需手动连接"
    popUpMsg(l_sMsg)
  endIf
  
end]]></Code>
  </Program>
</Programs>