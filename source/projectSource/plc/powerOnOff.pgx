<?xml version="1.0" encoding="utf-8" ?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2" >
  <Program name="powerOnOff" access="public" >
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1" >
      <Parameter name="x_bPowerOn" type="bool" use="value" xsi:type="element" dimensions="1" />
    </Parameters>
    <Code><![CDATA[begin
  if x_bPowerOn==true
    //Power on
    if !isPowered() and esStatus()!=2 and workingMode()==4
      autoConnectMove(true)
      enablePower()
      delay(1)
    endIf
  else
    //Power Off 
    if isPowered()
      disablePower()
      delay(1)
    endIf
  endIf
end]]></Code>
  </Program>
</Programs>