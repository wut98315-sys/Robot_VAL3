<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="send">
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_bErr" type="bool" xsi:type="array" size="1" />
      <Local name="i" type="num" xsi:type="array" size="1" />
      <Local name="l_bMcpEstop" type="bool" xsi:type="array" size="1" />
      <Local name="l_bEnabling" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
 
  //状态
  rs:bIsHome=(abs((herej()-savedata:jHome))<{2,2,2,2,2,2})
  rs:bIsEstop=(io:dRSI9["RbStop"]==false) 
  rs:bIsReady=(rs:_nOmacStat==1)
  rs:bIsCycle=(rs:_nOmacStat==3)
  
  call io:setDigOutput(io:dORbAtHome,rs:bIsHome,l_bErr)
  //stop
  call io:setDigOutput(io:dORbStopped,(rs:_nOmacStat==9),l_bErr)
  call io:setDigOutput(io:dORbReady,(rs:_nOmacStat==1),l_bErr)
  call io:setDigOutput(io:dORbRunning,(rs:_nOmacStat==3),l_bErr)
  call io:setDigOutput(io:dORbHeld,(rs:_nOmacStat==6),l_bErr)
  call io:setDigOutput(io:dORbManualMode,(workingMode()==1),l_bErr)
  call io:setDigOutput(io:dORbAutoMode,(workingMode()==4),l_bErr)
  call io:getDigIO(io:dRSI9["enabling"],l_bEnabling,l_bErr)
  call io:setDigOutput(io:dORbEnable,(l_bEnabling==true),l_bErr)
  call io:getDigIO(io:dRSI9["RbStop"],l_bMcpEstop,l_bErr)
  call io:setDigOutput(io:dOMcpEstop,(l_bMcpEstop==false),l_bErr)
  call io:setDigOutput(io:dORbMoving,!isSettled(),l_bErr)
  call io:setDigOutput(io:dORbHeartbeat,bLifebit,l_bErr)
  call io:setDigOutput(io:dORbPowerOn,isPowered(),l_bErr)
  
  //
  for i=0 to size(rs:_nAlarmCode)-1
    if rs:_nAlarmCode[i]>rs:nHeavyAlarmLev
      rs:_bHeavyAlarm=true
      //1.机器人错误代码
      call io:setAnaOutput(io:aOutput[2],rs:_nAlarmCode[rs:_nErrIndex],l_bErr)
    endIf
  endFor
  if rs:_bHeavyAlarm
    call io:setDigOutNoAlm(io:dORbAlarm,true,l_bErr)
  else
    call io:setDigOutNoAlm(io:dORbAlarm,false,l_bErr)
  endIf
  //  //jointforce
  //  getJointForce(nJointForce)
  //  for l_i = 0 to size(nJointForce)-1
  //    call io:setAnaOutput(io:aOutput[l_i],nJointForce[l_i],l_bErr)
  //  endFor
  
  //************************模拟量输出*****************************
  //0.机器人当前的运动速度
  call io:setAnaOutput(io:aOutput[1],getMonitorSpeed(),l_bErr)
  //1.反馈程序号
  call io:setAnaOutput(io:aOutput[0],rs:nProgCode,l_bErr)
end]]></Code>
  </Program>
</Programs>