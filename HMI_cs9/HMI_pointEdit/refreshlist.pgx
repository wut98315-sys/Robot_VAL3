<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="refreshlist" access="public">
    <Locals>
      <Local name="l_nSize" type="num" xsi:type="array" size="1" />
      <Local name="l_sMsg" type="string" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_nPointSize" type="num" xsi:type="array" size="1" />
      <Local name="l_nPoint" type="num" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  call trajectory:getPointSize(sTrajItem,l_nPointSize)

  //page
  if l_nPointSize<50
    nPageNum=1
  else
    nPageNum=roundUp(l_nPointSize/49)
  endIf
  
  if nPageNum==1
    resize(sList,1,l_nPointSize)
    for l_i = 0 to size(sList)-1
      call trajectory:pointToString(l_sMsg,sTrajItem,l_i+49*nPageIndex)
      sList[l_i]=toString("",l_i+49*nPageIndex)+l_sMsg
    endFor
  else
    if nPageIndex<nPageNum-1
      resize(sList,1,49)
      for l_i = 0 to 48
        call trajectory:pointToString(l_sMsg,sTrajItem,l_i+49*nPageIndex)
        sList[l_i]=toString("",l_i+49*nPageIndex)+l_sMsg
      endFor
    else
      if l_nPointSize%49==0
        resize(sList,1,49)
      else
        resize(sList,1,l_nPointSize%49)
      endIf
      for l_i = 0 to size(sList)-1
        call trajectory:pointToString(l_sMsg,sTrajItem,l_i+49*nPageIndex)
        sList[l_i]=toString("",l_i+49*nPageIndex)+l_sMsg
      endFor
        
    endIf
  endIf
  userPageBind("point","lst1","options",sList,size(sList),"r")
  sPageIndex=toString("",nPageIndex+1)
  sPageNum=toString("",nPageNum)
  //
  //  if nPageIndex>(nPageNum-1)
  //    nPageIndex=(nPageNum-1)
  //  endIf
  //  //slist
  //  if nPageIndex==(nPageNum-1)
  //    if l_nPointSize%49==0
  //      l_nSize=49
  //    else
  //      l_nSize=l_nPointSize%49
  //    endIf
  //    for l_i = 0 to l_nSize-1
  //      call trajectory:pointToString(l_sMsg,sTrajItem,l_i+49*nPageIndex)
  //      sList[l_i]=toString("",l_i+49*nPageIndex)+l_sMsg
  //    endFor
  //    if l_nSize<49
  //      for l_i= l_nSize to 48
  //        sList[l_i]=""
  //      endFor
  //    endIf
  //  else
  //    for l_i = 0 to size(sList)-1
  //      call trajectory:pointToString(l_sMsg,sTrajItem,l_i+49*nPageIndex)
  //      sList[l_i]=toString("",l_i+49*nPageIndex)+l_sMsg
  //    endFor
  //  endIf
  //  sPageIndex=toString("",nPageIndex+1)
  //  sPageNum=toString("",nPageNum)
  //  //sSelPoint=sList[nPointIndex-nPageIndex*49]
end]]></Code>
  </Program>
</Programs>