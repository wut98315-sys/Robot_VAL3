<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="removeActCmd">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nStackIndex" type="num" xsi:type="element" />
    </Parameters>
    <Code><![CDATA[begin
  actCmd[x_nStackIndex].nMoveID=-1
  actCmd[x_nStackIndex].nActionID=-1
  actCmd[x_nStackIndex].bActFinish[0]=false
end]]></Code>
  </Program>
</Programs>