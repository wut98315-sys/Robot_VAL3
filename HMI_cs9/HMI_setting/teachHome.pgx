<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="teachHome" access="public">
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  l_bResult=userPageConfirm("是否记录当前位置为home位置？")
  if l_bResult
    savedata:jHome=herej()
    savedata:libSave()
    delay(0.1)
    popUpMsg("home位置已记录并保存")
  endIf
end]]></Code>
  </Program>
</Programs>