<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="refreshInfo" access="public">
    <Code><![CDATA[begin
  //Version
  if utImg_Info.Events.bClick==true
    utImg_Info.Events.bClick=false     
    call hmiAlert("Version","info")
  endIf
end]]></Code>
  </Program>
</Programs>