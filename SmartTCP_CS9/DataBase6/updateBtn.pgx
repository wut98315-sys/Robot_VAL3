<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="updateBtn" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nItemIn" type="num" xsi:type="element" />
      <Parameter name="x_sComment" type="string" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_nI" type="num" xsi:type="array" size="1" />
      <Local name="l_nPos" type="num" xsi:type="array" size="1" />
      <Local name="l_sLongStr" type="string" xsi:type="array" size="1" />
      <Local name="l_sBtnText" type="string" xsi:type="array" size="8" />
    </Locals>
    <Code><![CDATA[begin
  switch sLanguage
    case "chinese"
      l_sLongStr=sHmiCN[x_nItemIn]
    break
    //
    case "english"
      l_sLongStr=sHmiEN[x_nItemIn]
    break
  endSwitch
  nBtnItem=x_nItemIn
  //
  for l_nI= 0 to 7
    l_nPos=find(l_sLongStr,",")
    if l_nPos!=-1
      l_sBtnText[l_nI]=left(l_sLongStr,l_nPos)
      l_sLongStr=delete(l_sLongStr,l_nPos+1,0)
    else
      l_sBtnText[l_nI]=l_sLongStr  
    endIf
    if l_sBtnText[l_nI]!="Null"
      utBtn_Bottom[l_nI].Common.sText=l_sBtnText[l_nI]
      utBtn_Bottom[l_nI].Appearance.bVisibility=true
    else
      utBtn_Bottom[l_nI].Common.sText=""
      utBtn_Bottom[l_nI].Appearance.bVisibility=false
    endIf
  endFor
end]]></Code>
  </Program>
</Programs>