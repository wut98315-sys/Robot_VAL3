<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="refreshList">
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  for l_i = 0 to size(sFrameList)-1
    sFrameList[l_i]=toString("",l_i)+","+savedata:fFrameItem[l_i].sName
  endFor
  
  for l_i = 0 to size(sToolList)-1
    sToolList[l_i]=toString("",l_i)+","+savedata:tToolItem[l_i].sName
  endFor
end]]></Code>
  </Program>
</Programs>