<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="CheckPosEqual">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_pA" type="point" xsi:type="element" />
      <Parameter name="x_bPos" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_pHere" type="point" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  l_pHere=here(utCurrentTool.tValue,world)
  if power(x_pA.trsf.x-l_pHere.trsf.x,2)+power(x_pA.trsf.y-l_pHere.trsf.y,2)+power(x_pA.trsf.z-l_pHere.trsf.z,2)+power(x_pA.trsf.rz-l_pHere.trsf.rz,2)<0.2
    x_bPos=true
  else
    x_bPos=false
  endIf
//  if power(x_pA.trsf.x-l_pHere.trsf.x,2)+power(x_pA.trsf.y-l_pHere.trsf.y,2)+power(x_pA.trsf.z-l_pHere.trsf.z,2)+power(x_pA.trsf.rx-l_pHere.trsf.rx,2)+power(x_pA.trsf.ry-l_pHere.trsf.ry,2)+power(x_pA.trsf.rz-l_pHere.trsf.rz,2)<1
//    x_bPos=true
//  else
//    x_bPos=false
//  endIf
end
]]></Code>
  </Program>
</Programs>