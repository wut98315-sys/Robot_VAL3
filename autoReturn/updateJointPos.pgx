<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="updateJointPos">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nIndex" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_jRef" type="jointRx" xsi:type="array" size="1" />
      <Local name="l_pPos" type="pointRx" xsi:type="array" size="1" />
      <Local name="l_tTool" type="tool" xsi:type="array" size="1" />
      <Local name="l_jResult" type="jointRx" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  // 回退前，基于后一个点[x_nIndex+1]或当前位置，重新更新jPointRec[x_nIndex]
  if bFirstUpdate==true
    l_jRef=herej()
  else
    // 参考关节l_jRef选择[x_nIndex+1]点
    if nMoveTypeRec[x_nIndex+1]==3
      l_jRef=jPointRec[x_nIndex+1,0]
    else
      l_jRef=jPointRec[x_nIndex+1,1]
    endIf
  endIf
  //
  // update joint
  link(l_tTool,flange)
  l_tTool.trsf=trToolRec[x_nIndex]
  l_pPos=jointToPoint(l_tTool,world,jPointRec[x_nIndex,1])
  pointToJoint(l_tTool,l_jRef,l_pPos,l_jResult)
  if jPointRec[x_nIndex,1]!=l_jResult
    jPointRec[x_nIndex,1]=l_jResult
    logMsg("更新jPointRec["+toString("",x_nIndex)+",1]")
  endIf
  // Movec have two points
  if nMoveTypeRec[x_nIndex]==3
    l_pPos=jointToPoint(l_tTool,world,jPointRec[x_nIndex,0])
    pointToJoint(l_tTool,jPointRec[x_nIndex,1],l_pPos,l_jResult)
    if jPointRec[x_nIndex,0]!=l_jResult
      jPointRec[x_nIndex,0]=l_jResult
      logMsg("更新jPointRec["+toString("",x_nIndex)+",0]")
    endIf
  endIf
end]]></Code>
  </Program>
</Programs>