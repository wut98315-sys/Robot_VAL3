<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="do_switch" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_sKey" type="string" xsi:type="element" />
      <Parameter name="x_nIndex" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_sValue" type="string" xsi:type="array" size="1" />
      <Local name="l_nIOindex" type="num" xsi:type="array" size="1" />
      <Local name="l_bErr" type="bool" xsi:type="array" size="1" />
      <Local name="l_nValue" type="num" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  waitEndMove()
  rs:bInSwitch=true
  l_sValue=progTemp:pProgItem[x_sKey].pProgTemplate[x_nIndex].sSwitchItem.sIOValue
  toNum(l_sValue,l_nIOindex,l_bResult)
  call io:getAnaIO(io:aInItem[l_nIOindex].aAio,l_nValue,l_bErr)
  rs:nSetSwitchValue=l_nValue
end]]></Code>
  </Program>
</Programs>