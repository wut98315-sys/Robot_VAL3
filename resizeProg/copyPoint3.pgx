<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="copyPoint3" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_sKey" type="string" xsi:type="element" />
      <Parameter name="x_nTarget" type="num" xsi:type="element" />
      <Parameter name="x_nSource" type="num" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //2024.12.23 add 增加点位索引
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pPointRx=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pPointRx
  //tTrajBuffer[x_sKey].pPointItem[x_nTarget].pPointRx[1]=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pPointRx[1]
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].jJointRx=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].jJointRx
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].sID=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].sID
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].bMarked=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].bMarked
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pInter=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pInter
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.mMdesc=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.mMdesc
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.nMoveType=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.nMoveType
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.nActionIndex=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.nActionIndex
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.nPercentage=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.nPercentage
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.nDelay=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.nDelay
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.nSigValue=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.nSigValue
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.bSafePoint=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.bSafePoint
  for l_i = 0 to 2
    tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.iIfItem.nSigType[l_i]=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.iIfItem.nSigType[l_i]
    tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.iIfItem.nSigIndex[l_i]=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.iIfItem.nSigIndex[l_i]
    tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.iIfItem.nValue[l_i]=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.iIfItem.nValue[l_i]
  endFor
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.iIfItem.bANDOR[0]=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.iIfItem.bANDOR[0]
  tTrajBuffer[x_sKey].pPointItem[x_nTarget].pParaItem.iIfItem.bANDOR[1]=trajTemp:tTrajItem[x_sKey].pPointItem[x_nSource].pParaItem.iIfItem.bANDOR[1]
  
end]]></Code>
  </Program>
</Programs>