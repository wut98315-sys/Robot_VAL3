<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="onStart" access="public">
    <Locals>
      <Local name="l_i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //list
  resize(sActionList,1,size(actdata:aActItem))
  for l_i = 0 to size(sActionList)-1
    sActionList[l_i]=toString("",l_i)+","+actdata:aActItem[l_i].sComment
  endFor
  //
  //  resize(sIOList,1,size(io:dInItem))
  //  for l_i = 0 to size(sIOList)-1
  //    sIOList[l_i]=toString("",l_i)
  //  endFor
  //  //
  insert(sActionList[0])
  sActionList[0]="--"
  //insert(sIOList[0])
  sLastList=""
  sSelIO="--"
end]]></Code>
  </Program>
</Programs>