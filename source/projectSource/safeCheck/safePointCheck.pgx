<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="safePointCheck" access="public">
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_bErr" type="bool" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  for l_i = 0 to size(safeTemp:sSPoint)-1
    call computeSPoint(l_i,l_bResult)
    //O_safePoint[l_i]=(l_bResult==true)
    call io:setDigOutput(O_safePoint[l_i],l_bResult,l_bErr)
  endFor
end]]></Code>
  </Program>
</Programs>