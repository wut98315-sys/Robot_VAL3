<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="copy" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_sKey" type="string" xsi:type="element" />
      <Parameter name="x_bToSave" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_sName" type="string" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  if x_sKey!=""
    l_bResult=userPagePrompt("复制-输入新名称：",l_sName)
    if l_bResult
      if !isDefined(progTemp:pProgItem[l_sName])
        insert(progTemp:pProgItem[l_sName])
        call copyItem(l_sName,x_sKey)
      
        x_bToSave=true
      else
        userPageAlert("存在相同名称的程序！")
      endIf
    endIf
  endIf
end]]></Code>
  </Program>
</Programs>