<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="getProgItemIndex" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_sKey" type="string" xsi:type="element" />
      <Parameter name="x_sSelProgItem" type="string" xsi:type="element" />
      <Parameter name="x_nIndex" type="num" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_nSize" type="num" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  call getProgItemSize(x_sKey,l_nSize)
  if l_nSize==1 and progTemp:pProgItem[x_sKey].pProgTemplate[0].sTRAJname==""
    x_nIndex=0
  else
    toNum(x_sSelProgItem,x_nIndex,l_bResult)
  endIf
  
end]]></Code>
  </Program>
</Programs>