<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="getSize" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nSize" type="num" xsi:type="element" use="reference" />
      <Parameter name="x_nSize1" type="num" xsi:type="element" use="reference" />
    </Parameters>
    <Code><![CDATA[begin
  if io:nMaxdigital%16!=0 and nPageIndex==nPage-1
    x_nSize=io:nMaxdigital%16
  else
    x_nSize=16
  endIf
 if io:nMaxAnalog%16!=0 and nPageIndex==nPage-1
    x_nSize1=io:nMaxAnalog%16
  else
    x_nSize1=16
  endIf
end]]></Code>
  </Program>
</Programs>