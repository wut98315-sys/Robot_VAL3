<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="new" access="public">
    <Locals>
      <Local name="l_sPage" type="string" xsi:type="array" size="1" />
      <Local name="l_bExit" type="bool" xsi:type="array" size="1" />
      <Local name="l_i" type="num" xsi:type="array" size="1" />
      <Local name="l_nToolIndex" type="num" xsi:type="array" size="1" />
      <Local name="l_nFrameIndex" type="num" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_bResult1" type="bool" xsi:type="array" size="1" />
      <Local name="l_nSize" type="num" xsi:type="array" size="1" />
      <Local name="l_sHeader" type="string" xsi:type="array" size="1" />
      <Local name="l_nID" type="num" xsi:type="array" size="1" />
      <Local name="l_bFound" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  // l_sPage=""
  do
    if util:sPage!="new"
      util:sPage="new"
      resize(sFrameList,1,size(saveData:fFrameItem))
      resize(sToolList,1,size(saveData:tToolItem))
      for l_i = 0 to size(sFrameList)-1
        sFrameList[l_i]=toString("",l_i)+","+saveData:fFrameItem[l_i].sName
      endFor
      for l_i = 0 to size(sToolList)-1
        sToolList[l_i]=toString("",l_i)+","+saveData:tToolItem[l_i].sName
      endFor
      sNewName=""
      nMoveID=0
      bCancel=false
      bConfirm=false
      sSelFrame=""
      sSelTool=""
      userPageBind("new","txt1","value",sNewName,1,"rw")
      userPageBind("new","nmb1","value",nMoveID,1,"rw")
      userPageBind("new","cbx1","options",sFrameList,size(sFrameList),"r")
      userPageBind("new","cbx2","options",sToolList,size(sToolList),"r")
      userPageBind("new","cbx1","value",sSelFrame,1,"rw")
      userPageBind("new","cbx2","value",sSelTool,1,"rw")
      userPageBindClick("new","btn1",bConfirm,true)
      userPageBindClick("new","btn2",bCancel,true)
      userPage(util:sPage)
      delay(0.5)
      
    endIf
    //
    toNum(sSelFrame,l_nFrameIndex,l_bResult)
    toNum(sSelTool,l_nToolIndex,l_bResult1)
    //button
    if bConfirm
      bConfirm=false
      if l_bResult and l_bResult1
        call trajectory:getSize(l_nSize)
        call getTrajID()
        l_nID=0
        do
          l_i=0
          do
            if l_nID==nIDIsExit[l_i]
              l_bFound=true
               l_nID=l_nID+1
            else
              l_bFound=false
            endIf
            l_i=l_i+1
          until l_bFound==false or l_i>=size(nIDIsExit)
         
          until l_bFound==false
       
        if l_nSize<10
          l_sHeader="0"+toString("",l_nID)+" "+sNewName
        else 
          l_sHeader=toString("",l_nID)+" "+sNewName
        endIf
          call trajectory:new(l_sHeader,l_nFrameIndex,l_nToolIndex,nMoveID,bToSave)
          call trajectory:onSave(bToSave)
          sSelTraj=l_sHeader
          l_bExit=true
      else
        popUpMsg("设定的数据非法")
      endIf
    elseIf bCancel
      bCancel=false
      l_bExit=true
    endIf
    
    
    delay(0)
  until l_bExit==true
 
end]]></Code>
  </Program>
</Programs>