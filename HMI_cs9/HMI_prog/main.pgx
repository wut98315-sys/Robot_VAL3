<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="main" access="public">
    <Locals>
      <Local name="l_bExit" type="bool" xsi:type="array" size="1" />
      <Local name="l_bRefresh" type="bool" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
      <Local name="l_sEntryPassword" type="string" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  do
    if util:sPage!="prog"
      util:sPage="prog"
      call onStart()
      call bind() 
      userPage(util:sPage)
      delay(0.5)
      l_bRefresh=true
    endIf
    
    if bBool[0]
      bBool[0]=false
      //新建
      call program:new(bToSave)
      l_bRefresh=true
    elseIf bBool[1]
      bBool[1]=false
      //编辑
      if bToSave
        bToSave=false
        call program:onSave(bToSave)
      endIf
      if sSelProg!=""
        call editprog:main(sSelProg)
      else
        userPageAlert("未选择有效项")
      endIf
      l_bRefresh=true
    elseIf bBool[2]
      bBool[2]=false
      //删除
      if find(sSelProg,"prod")!=-1
        //ADD BY Liuzhengang20260225        
        l_bResult=userPagePrompt("请输入密码",l_sEntryPassword)
        if l_bResult==false
          return
        else
          if l_sEntryPassword!=sInitialPassword[0]
            popUpMsg("密码错误")
            return
          else
            call program:deleteProg(sSelProg,bToSave)
            l_bRefresh=true
          endIf
        endIf
        //        userPageAlert("不可删除选项！")
        //        return
      else
        call program:deleteProg(sSelProg,bToSave)
        l_bRefresh=true
      endIf

    elseIf bBool[3]
      bBool[3]=false
      //保存
      call program:onSave(bToSave)
    elseIf bBool[4]
      bBool[4]=false
      //复制
      l_bRefresh=true
      call program:copy(sSelProg,bToSave)
    elseIf bBool[5]
      bBool[5]=false
      call simulate:simulatePROG(sSelProg)
    elseIf bBool[6]
      bBool[6]=false
      nPageIndex=0
      l_bRefresh=true
    elseIf bBool[7]
      bBool[7]=false
      if nPageIndex>0
        nPageIndex=nPageIndex-1
        l_bRefresh=true
      endIf
     
    elseIf bBool[8]
      bBool[8]=false
      if nPageIndex<nPageNum-1
        nPageIndex=nPageIndex+1
        l_bRefresh=true
      endIf
    elseIf bBool[9]
      bBool[9]=false
      nPageIndex=nPageNum-1
      l_bRefresh=true
    elseIf bBack
      bBack=false
      if bToSave
        bToSave=false
        l_bResult=userPageConfirm("是否保存数据")
        if l_bResult
          call program:onSave(bToSave)
        endIf
      endIf
      l_bExit=true
    endIf
    
    if l_bRefresh
      l_bRefresh=false
      // call program:getProgList(sProgLsit)
      call refreshlist()
      // userPageBind("prog","lst1","options",sProgLsit,size(sProgLsit),"r")
      // call refreshproglist()
    endIf
    
    
    delay(0)
  until l_bExit==true
end]]></Code>
  </Program>
</Programs>