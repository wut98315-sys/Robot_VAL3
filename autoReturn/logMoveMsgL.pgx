<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="logMoveMsgL">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_pPoint" type="pointRx" xsi:type="element" />
      <Parameter name="x_tTool" type="tool" xsi:type="element" />
      <Parameter name="x_mSpeed" type="mdesc" xsi:type="element" />
      <Parameter name="x_nMoveId" type="num" xsi:type="element" />
      <Parameter name="x_bExact" type="bool" xsi:type="element" />
    </Parameters>
    <Locals>
      <Local name="l_sCode" type="string" xsi:type="array" size="1" />
      <Local name="l_jRef" type="jointRx" xsi:type="array" size="1" />
      <Local name="l_jResult" type="jointRx" xsi:type="array" size="1" />
      <Local name="l_bResult" type="bool" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  // 
  // 走直线or圆弧时，记录目标点位的joint值参考前一个点的joint（如果是第一次记录，参考herej()）
  if nRecIndex<200
    // l
    if nRecIndex>=1
      l_jRef=jPointRec[nRecIndex-1,1]
    else
      l_jRef=herej()
    endIf
    l_bResult=pointToJoint(x_tTool,l_jRef,x_pPoint,l_jResult)
    //
    if l_bResult==true
      setMutex(bPushToStack)
      jPointRec[nRecIndex,1]=l_jResult
      trToolRec[nRecIndex]=x_tTool.trsf
      mSpeedRec[nRecIndex]=x_mSpeed
      nMoveIdRec[nRecIndex]=x_nMoveId
      bExact[nRecIndex]=x_bExact
      nMoveTypeRec[nRecIndex]=1
      //logMsg("record moveL."+toString("",nMoveIdRec[nRecIndex]))
      nRecIndex=nRecIndex+1
      bPushToStack=false
    else
      // 该位置无关节解
    endIf
  else
    //popUpMsg("记录点数超过容量.")
  endIf
  
end]]></Code>
  </Program>
</Programs>