          call db:updateInfo(103,db:utLbl_Info1.Data.nVal,db:utLbl_Info1.Common.sText,"1","Touch to reference pointer in any attitude")
          call db:updateInfo(105,db:utLbl_Info2.Data.nVal,db:utLbl_Info2.Common.sText,"2","Press Here button to save the position")
          call db:updateInfo(104,db:utLbl_Info3.Data.nVal,db:utLbl_Info3.Common.sText,"3","Press Calc. button to get the TCP value")
