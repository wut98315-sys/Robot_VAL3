    break
    case 29
      rs:sTrajStatus="开始执行prod29"
      call prog:makeTraj("prod29")

    break
    case 30
      rs:sTrajStatus="开始执行prod30"
      call prog:makeTraj("prod30")

    break
    case 31
      rs:sTrajStatus="开始执行prod31"
      call prog:makeTraj("prod31")

    break
    case 32
      rs:sTrajStatus="开始执行prod032"
      call prog:makeTraj("prod32")

    break
    case 33
      rs:sTrajStatus="开始执行prod33"
      call prog:makeTraj("prod33")

    break
    case 34
      rs:sTrajStatus="开始执行prod34"
      call prog:makeTraj("prod34")

    break
    case 35
      rs:sTrajStatus="开始执行prod35"
      call prog:makeTraj("prod35")

    break
    case 36
      rs:sTrajStatus="开始执行prod36"
      call prog:makeTraj("prod36")

    break

    case 37
      rs:sTrajStatus="开始执行prod37"
      call prog:makeTraj("prod37")
    break

    case 38
      rs:sTrajStatus="开始执行prod38"
      call prog:makeTraj("prod38")
