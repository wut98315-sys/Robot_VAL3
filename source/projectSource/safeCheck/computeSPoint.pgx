<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="computeSPoint" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nIndex" type="num" xsi:type="element" />
      <Parameter name="x_bResult" type="bool" xsi:type="element" use="reference" />
    </Parameters>
    <Locals>
      <Local name="l_tTool" type="tool" xsi:type="array" size="1" />
      <Local name="l_pHere" type="pointRx" xsi:type="array" size="1" />
      <Local name="l_trsf" type="trsf" xsi:type="array" size="1" />
      <Local name="l_nDistance" type="num" xsi:type="array" size="1" />
    </Locals>
    <Code><![CDATA[begin
  //link(l_tTool,flange)
  //call savedata:getTool(nToolIndex,l_tTool)
  l_pHere=here(flange,world)
  l_trsf=safeTemp:sSPoint[x_nIndex].pPointRx.trsf
  l_nDistance=distance(l_pHere.trsf,l_trsf)
  if abs(l_nDistance)<5
    x_bResult=true
  else
    x_bResult=false
  endIf
end]]></Code>
  </Program>
</Programs>