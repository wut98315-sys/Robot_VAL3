    break
    case 49
      rs:sTrajStatus="开始执行prod49"
      call prog:makeTraj("prod49")
    break

    case 50
      rs:sTrajStatus="开始执行prod50"
      call prog:makeTraj("prod50")
    break

  endSwitch
  if l_bStartClock and l_nLastAct!=rs:nActCode
    rs:_nCTIndex=(rs:_nCTIndex+1)%size(rs:_nCycleTime)
    rs:_nCycleTime[rs:_nCTIndex]=clock()-l_nClock
  else
    l_bStartClock=true
  endIf
  l_nClock=clock()
  l_nLastAct=rs:nActCode
  //delay(0)
  //
  rs:_nOmacStat=1
  rs:sTrajStatus=""
  rs:_sRobotStatus="当前件生产结束"
  //2025.1.6 add 结束扭矩记录程序
  if taskStatus("getForce")!=-1
    delay(0.2)
    taskKill("getForce")
  endIf
end]]></Code>
  </Program>
</Programs>